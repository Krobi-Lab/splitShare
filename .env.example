# ---------------------------------------------------------------------------
# SplitHome / splitShare — environment contract
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (Neon in prod, local Postgres in dev) ---
# Pooled connection (PgBouncer). Used by the app at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/splitshare_dev"
# Direct connection (no pooler). Used by `prisma migrate` and DDL only.
DIRECT_URL="postgresql://user:password@localhost:5432/splitshare_dev"

# --- Auth.js v5 / NextAuth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Vercel Blob (receipt storage) ---
BLOB_READ_WRITE_TOKEN=""

# --- Email (Resend). Unset => email adapter is a no-op logger. ---
EMAIL_API_KEY=""
EMAIL_FROM="SplitHome <no-reply@example.com>"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Cron (Vercel Cron -> /api/cron/reminders) ---
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Uploads ---
MAX_UPLOAD_BYTES="10485760"
